# SalemX call service staging Synapse validation smoke template.
# Copy this file outside the repo or to an ignored local path before adding real values.
# Do not commit real Matrix access tokens, room IDs, user IDs, device IDs, Redis URLs, or service secrets.

# Required. Public base URL of the deployed call service, without a trailing slash.
CALL_SERVICE_BASE_URL="https://call-service-staging.example.invalid"

# Required. Operator-local Matrix access token for the caller test account.
CALLER_MATRIX_ACCESS_TOKEN="<matrix-access-token-do-not-commit>"

# Required. Device ID returned by /_matrix/client/v3/account/whoami for the caller token.
CALLER_DEVICE_ID="<caller-device-id-do-not-commit>"

# Required. Encrypted direct 1:1 staging room containing only caller and peer.
STAGING_ENCRYPTED_DIRECT_ROOM_ID="<encrypted-direct-room-id-do-not-commit>"

# Required. Peer user ID for the encrypted direct 1:1 staging room.
STAGING_PEER_USER_ID="<peer-user-id-do-not-commit>"

# Optional negative fixtures. Leave unset to skip those cases.
WRONG_DEVICE_ID="<wrong-device-id-do-not-commit>"
NEGATIVE_UNENCRYPTED_ROOM_ID="<unencrypted-room-id-do-not-commit>"
NEGATIVE_NON_1_TO_1_ROOM_ID="<non-1-to-1-room-id-do-not-commit>"
NEGATIVE_PEER_NOT_JOINED_USER_ID="<peer-not-joined-user-id-do-not-commit>"
NEGATIVE_CALLER_NOT_JOINED_ROOM_ID="<caller-not-joined-room-id-do-not-commit>"
