# SalemX call service staging environment template.
# Copy to server/salemx-call-service/deploy/staging.env or another ignored local path.
# Do not commit real tokens, API secrets, Redis URLs with credentials, room IDs, user IDs, or device IDs.

# Local helper value used by check_staging_readiness.sh and smoke scripts.
CALL_SERVICE_BASE_URL="http://127.0.0.1:8088"

# Service mode guardrails.
SALEMX_CALL_SERVICE_MODE="staging"
SALEMX_CALL_SERVICE_FAKE_MODE="0"

# Synapse validation. Operator fills with staging values locally only.
SYNAPSE_BASE_URL="https://<operator-synapse-host>"
SYNAPSE_ADMIN_TOKEN="<operator-synapse-admin-token-do-not-commit>"

# LiveKit staging config. LIVEKIT_URL must be wss:// in staging.
LIVEKIT_URL="wss://<operator-livekit-host>"
LIVEKIT_API_KEY="<operator-livekit-api-key-do-not-commit>"
LIVEKIT_API_SECRET="<operator-livekit-api-secret-do-not-commit>"

# Token/allocation bounds.
TOKEN_TTL_SECONDS="120"
ALLOCATION_TTL_SECONDS="300"

# Redis-backed shared allocation/rate limit stores.
SALEMX_CALL_SERVICE_STORAGE_KEY_SECRET="<operator-storage-key-secret-do-not-commit>"
SALEMX_CALL_SERVICE_ALLOCATION_STORE="redis"
SALEMX_CALL_SERVICE_ALLOCATION_STORE_URL="redis://<operator-redis-host>/0"
SALEMX_CALL_SERVICE_RATE_LIMIT_STORE="redis"
SALEMX_CALL_SERVICE_RATE_LIMIT_STORE_URL="redis://<operator-redis-host>/0"
SALEMX_CALL_SERVICE_RATE_LIMIT_PER_MINUTE="30"

# Keep logs operational and redacted.
LOG_LEVEL="INFO"
